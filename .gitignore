# Generated CA state contains private keys and passwords.
step-ca/data/
step-ca/secrets/
step-ca/offline-root-backup/
code-signing/publisher/*
!code-signing/publisher/.gitkeep
code-signing/artifacts/*
!code-signing/artifacts/.gitkeep

# Issued server identities and ACME account keys.
nginx/*/certs/
client/accounts/
client/certificates/

# Local environment overrides and credentials.
.env
*.password
*.key
*.pem
*.pfx
*.p12

# Monitoring output and exercise evidence.
monitoring/output/
evidence/

# Common local/editor artifacts.
.DS_Store
Thumbs.db
.vscode/

# Python cache and local virtual environments.
__pycache__/
*.py[cod]
.venv/
